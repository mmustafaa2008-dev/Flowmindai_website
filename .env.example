# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Public site URL used for canonical links, sitemap and Open Graph metadata.
# During development / before a custom domain exists, this can be the
# Vercel-assigned URL (e.g. https://flowmind-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Resend API key used by the contact form email route
# (app/api/contact/route.ts). Created in the Resend dashboard.
# Do NOT prefix with NEXT_PUBLIC_ — this must never reach client JavaScript.
RESEND_API_KEY=

# Server-only "From" address for outgoing inquiry emails. Resend only
# allows sending from an address on a domain verified in that Resend
# account — do NOT assume flowmindai09@gmail.com (or any other unverified
# address/domain) works here.
#
# - Local development / before a custom domain is verified: use Resend's
#   shared test sender, e.g. onboarding@resend.dev (works out of the box
#   with any Resend account, no domain verification required).
# - Production: use an address on a domain that has been added and
#   verified in the Resend dashboard (e.g. inquiries@flowmindai.com) —
#   never invent/guess a production domain here.
#
# The visitor's own email is set as replyTo (see route.ts), not as From —
# Resend requires From to be on a domain you've verified.
RESEND_FROM_EMAIL=
