# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Public site URL used for canonical links, sitemap and Open Graph metadata.
# During development / before a custom domain exists, this can be the
# Vercel-assigned URL (e.g. https://flowmind-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Resend API key used by the contact form email route.
# Created in the Resend dashboard. Configured in Phase 8.
# Do NOT prefix with NEXT_PUBLIC_ — this must never reach client JavaScript.
RESEND_API_KEY=
